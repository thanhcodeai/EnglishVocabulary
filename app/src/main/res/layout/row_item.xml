<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="6dp" android:background="@drawable/button_outline" android:padding="16dp" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="92dp" android:clickable="true" android:focusable="true">
 <FrameLayout android:layout_width="52dp" android:layout_height="56dp" android:background="@drawable/bg_soft">
 <ImageView android:id="@+id/row_icon" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center" android:src="@drawable/ic_book" android:importantForAccessibility="no" app:tint="@color/ui_brand"/>
 <TextView android:id="@+id/row_marker" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:visibility="gone" android:textColor="@color/ui_brand" android:textSize="20sp" android:fontFamily="@font/nunito_bold" android:importantForAccessibility="no"/>
 </FrameLayout>
 <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="14dp" android:layout_marginEnd="8dp">
 <TextView android:id="@+id/row_kicker" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/ui_brand" android:textSize="10sp" android:fontFamily="@font/nunito_bold" android:visibility="gone"/>
 <TextView android:id="@+id/row_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/ui_ink" android:textSize="18sp" android:fontFamily="@font/nunito_bold"/>
 <TextView android:id="@+id/row_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/ui_muted" android:textSize="13sp" android:lineSpacingExtra="2dp"/>
 </LinearLayout><ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_back" android:rotation="180" app:tint="@color/ui_muted" android:importantForAccessibility="no"/>
</LinearLayout>
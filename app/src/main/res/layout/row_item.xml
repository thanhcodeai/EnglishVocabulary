<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="6dp" android:minHeight="92dp" android:focusable="true" android:clickable="true" app:cardCornerRadius="22dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/ui_card" app:strokeColor="@color/ui_line" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
        <TextView android:id="@+id/row_marker" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:background="@drawable/bg_soft" android:textColor="@color/ui_brand" android:textSize="20sp" android:fontFamily="sans-serif-medium" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="14dp" android:layout_marginEnd="8dp">
            <TextView android:id="@+id/row_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/ui_ink" android:textSize="17sp" android:fontFamily="sans-serif-medium" />
            <TextView android:id="@+id/row_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/ui_muted" android:textSize="13sp" android:lineSpacingExtra="3dp" />
        </LinearLayout>
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_back" android:rotation="180" app:tint="@color/ui_muted" android:importantForAccessibility="no" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>